{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "엑셀 취합 도구",
  "mainBinaryName": "merge-master",
  "identifier": "com.mergemaster.host",
  "build": {
    "beforeDevCommand": "pnpm --filter @mm/host dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @mm/host build",
    "frontendDist": "../apps/host/dist"
  },
  "app": {
    "windows": [
      {
        "title": "엑셀 취합 도구",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "displayLanguageSelector": false,
        "startMenuFolder": "엑셀 취합 도구",
        "installerIcon": "icons/icon.ico"
      }
    },
    "publisher": "엑셀 취합 도구",
    "copyright": "사내 배포용",
    "category": "Productivity",
    "shortDescription": "엑셀 양식을 브라우저로 함께 채우고 다시 엑셀로 저장하는 취합 도구",
    "longDescription": "Excel에서 불러온 시트를 사내 LAN으로 열어 여러 사람이 브라우저로 동시에 입력하고, 호스트가 진행을 지켜본 뒤 결과를 다시 엑셀로 저장합니다."
  }
}
